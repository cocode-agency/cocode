{
  "name": "@cocode-agency/tui",
  "version": "1.0.2",
  "description": "Cocode terminal client for DeepSeek DSH sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocode-agency/cocode.git",
    "directory": "cocode-tui"
  },
  "homepage": "https://github.com/cocode-agency/cocode#readme",
  "bugs": {
    "url": "https://github.com/cocode-agency/cocode/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.19 || >=24",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node ./bin/cocode-tui.mjs",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "lint": "oxlint src packages test",
    "lint:fix": "oxlint --fix src packages test",
    "format": "pnpm run lint:fix",
    "format:check": "pnpm run lint",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/publishable-manifest.mjs apply",
    "postpack": "node scripts/publishable-manifest.mjs restore",
    "pack:check": "pnpm run build && node scripts/release-check.mjs",
    "release:check": "pnpm run pack:check"
  },
  "bin": {
    "cocode": "bin/cocode-tui.mjs"
  },
  "files": [
    "bin",
    "dist/cocode-tui.mjs",
    "dist/cocode-tui.meta.json",
    "docs",
    "README.md"
  ],
  "dependencies": {
    "@cocode-agency/host-supervisor": "link:../cocode-host-supervisor",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@cocode/tui-connection": "workspace:*",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.2",
    "husky": "9.1.7",
    "ink": "^7.1.1",
    "lint-staged": "15.5.2",
    "marked": "^18.0.9",
    "oxlint": "1.76.0",
    "react": "^19.2.0",
    "string-width": "^7.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrap-ansi": "^10.0.0",
    "yaml": "^2.9.0"
  }
}
