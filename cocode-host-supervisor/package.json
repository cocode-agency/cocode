{
  "name": "@cocode-agency/host-supervisor",
  "version": "0.1.0",
  "description": "Shared lifecycle supervisor for the Cocode DSH host.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocode-agency/cocode.git",
    "directory": "cocode-host-supervisor"
  },
  "homepage": "https://github.com/cocode-agency/cocode#readme",
  "bugs": {
    "url": "https://github.com/cocode-agency/cocode/issues"
  },
  "type": "module",
  "main": "packages/host-supervisor/lib/index.js",
  "types": "packages/host-supervisor/lib/index.d.ts",
  "bin": {
    "cocode-host-supervisor": "packages/host-supervisor/bin/cocode-host-supervisor.mjs"
  },
  "exports": {
    ".": {
      "types": "./packages/host-supervisor/lib/index.d.ts",
      "import": "./packages/host-supervisor/lib/index.js"
    },
    "./runtime-closure": "./packages/host-supervisor/lib/runtime-closure.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "packages/host-supervisor/lib",
    "packages/host-supervisor/bin",
    "runtime"
  ],
  "scripts": {
    "build": "node packages/host-supervisor/scripts/build.mjs",
    "build:with-gui-plugins": "node packages/host-supervisor/scripts/build.mjs --include-gui-plugins",
    "typecheck": "tsc --noEmit -p packages/host-supervisor/tsconfig.json",
    "pretest": "pnpm run build",
    "test": "node --test packages/host-supervisor/test/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-frontend-static": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-query-sqlite": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-telemetry-otel": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-loader": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.1-rc.2",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "playwright-core": "1.62.1",
    "schemastery": "^3.18.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
