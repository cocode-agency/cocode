# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.idea/
*.swp
*.swo
*~

# Local runtime data
/.cocode/
/cocode-gui/.cocode/
/cocode-tui/.cocode/
/cocode-tui/.sessions/

# Harness nested copy — prefer sibling clone at ~/www/cocode-harness
/cocode-harness/

# Third-party reference clones (local scratch, not product)
/refer/

# cocode-gui — local dev scratch ignored; guide/ and rfc/ are versioned
/cocode-gui/.dev/
!/cocode-gui/.dev/
/cocode-gui/.dev/*
!/cocode-gui/.dev/guide/
!/cocode-gui/.dev/guide/**
!/cocode-gui/.dev/rfc/
!/cocode-gui/.dev/rfc/**

# cocode-tui — local dev scratch ignored; rfc/ and home README are versioned
/cocode-tui/.dev/
!/cocode-tui/.dev/
/cocode-tui/.dev/*
!/cocode-tui/.dev/rfc/
!/cocode-tui/.dev/rfc/**
!/cocode-tui/.dev/home/
/cocode-tui/.dev/home/*
!/cocode-tui/.dev/home/README.md

# Root design dumps that are not part of the product
/design-system.html
/*.jpg
/*.jpeg
/*.png
/*.webp
/*.gif

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist-electron/
build/
out/
/release/
/cocode-gui/release/
*.tsbuildinfo
*.tgz

