{
	"compilerOptions": {
		"target": "ESNext",
		"module": "commonjs",
		"types": ["node"],
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noImplicitAny": true,
		"sourceMap": true,
		"baseUrl": ".",
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["src/renderer/*"],
			"@deepseek-ai/dsh-client-web": ["src/renderer/types/dsh-client-web.d.ts"],
			"@cocode-agency/host-supervisor/runtime-closure": [
				"../cocode-host-supervisor/packages/host-supervisor/lib/runtime-closure.d.ts"
			]
		},
		"outDir": "dist",
		"moduleResolution": "node",
		"resolveJsonModule": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"electron-builder.config.ts",
		"electron.vite.config.ts",
		"vite*.config.ts"
	],
	"exclude": ["node_modules", "packages/cocode", ".cache", "release"]
}
