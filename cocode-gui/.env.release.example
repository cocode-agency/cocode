# Copy to .env.release for local release builds. Never commit .env.release.
# Release commands require a native runner for the target platform/architecture.
# Linux AppImage releases do not require signing credentials. The Linux release
# commands still enforce the native host/architecture gate and never publish.

# Public application metadata. Override these for a downstream distribution.
ELECTRON_APP_ID=
RELEASE_COPYRIGHT=Copyright © 2026 Cocode Contributors
RELEASE_DESCRIPTION=Cocode Desktop
RELEASE_HOMEPAGE=https://github.com/cocode-agency/cocode
# Optional generic runtime feed override. The package repository is used when empty.
ELECTRON_UPDATE_REPOSITORY=
ELECTRON_AUTO_UPDATE=
ELECTRON_UPDATE_INTERVAL=10 minutes

# Optional local asset paths. The defaults use the committed Cocode icons.
MACOS_ICON_PATH=
WINDOWS_ICON_PATH=

# macOS signing. The certificate must already be installed in the selected keychain,
# or be imported by your local/CI setup before running the release command.
MAC_SIGNING_IDENTITY=
MAC_SIGNING_KEYCHAIN=
MAC_ENTITLEMENTS_PATH=resources/entitlements.mac.plist
MAC_PLUGIN_ENTITLEMENTS_PATH=resources/entitlements.mac.plugin.plist
# PKG signing requires a separate Developer ID Installer certificate.
# Do not reuse MAC_SIGNING_IDENTITY (Developer ID Application).
MAC_INSTALLER_SIGNING_IDENTITY=
MAC_INSTALLER_APP_IDENTIFIER=com.cocode.desktop
MAC_INSTALLER_CLI_IDENTIFIER=com.cocode.desktop.cli
MAC_CLI_INSTALL_PATH=/usr/local/bin/cocode

# Choose exactly one notarization strategy:
# 1) App Store Connect API key path + ID + issuer.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# 2) A notarytool Keychain profile.
APPLE_KEYCHAIN_PROFILE=
APPLE_KEYCHAIN=
# 3) Apple ID + app-specific password + Team ID.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# Windows Authenticode signing. Formal NSIS releases only use the team signing service.
WINDOWS_SIGN_MODE=service
WINDOWS_SIGN_SERVICE_URL=
# Credential returned by the shared Windows signing service. Keep this local/CI-only.
SIGN_CERTIFICATE=
WINDOWS_SIGN_CREDENTIAL_TARGET=cocode/windows-sign
WINDOWS_SIGN_DESCRIPTION=Cocode Desktop
WINDOWS_SIGN_TIMEOUT_MS=1200000
WINDOWS_SIGN_RETRY_COUNT=2
# Optional post-signing identity pinning. Leave blank for the first signed build;
# populate from Get-AuthenticodeSignature after confirming the service certificate.
WINDOWS_SIGN_CERTIFICATE_SUBJECT=
WINDOWS_SIGN_CERTIFICATE_SHA1=
WINDOWS_TIMESTAMP_SERVER=http://timestamp.digicert.com
