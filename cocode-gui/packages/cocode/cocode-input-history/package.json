{
  "name": "cocode-input-history",
  "version": "0.1.0-cocode.0",
  "description": "Recall the last sent message with ArrowUp in an empty composer.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "cocode": {
    "runtimeDependencies": []
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "cordis": "^4.0.0-rc.7",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
