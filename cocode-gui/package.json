{
	"name": "@cocode/gui-root",
	"productName": "Cocode",
	"version": "1.0.1",
	"description": "Cocode GUI Root",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cocode-agency/cocode.git"
	},
	"type": "module",
	"main": ".vite/build/main.mjs",
	"private": true,
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": "10.34.5"
	},
	"os": [
		"darwin",
		"win32",
		"linux"
	],
	"cpu": [
		"x64",
		"arm64"
	],
	"scripts": {
		"postinstall": "node scripts/harden-electron-default-app.mjs",
		"dev": "node scripts/start-with-dsh-runtime.mjs",
		"dev:web": "node scripts/start-web-dev.mjs",
		"start": "node scripts/start-with-dsh-runtime.mjs",
		"build:cocode-plugins": "node scripts/cocode-plugins.mjs build",
		"test:cocode-plugins": "node scripts/cocode-plugins.mjs test && corepack pnpm@10.34.5 --dir ../cocode-host-supervisor run test",
		"typecheck:cocode-plugins": "node scripts/cocode-plugins.mjs typecheck && corepack pnpm@10.34.5 --dir ../cocode-host-supervisor run typecheck",
		"stage:dsh": "node scripts/stage-dsh-runtime.mjs",
		"build:supervisor": "node scripts/build-supervisor.mjs",
		"build:tui": "node scripts/build-tui.mjs",
		"build:runtime": "node scripts/build-runtime.mjs",
		"generate:mac-icons": "node scripts/icons/generate-macos-icons.mjs",
		"verify:runtime": "node scripts/verify-dsh-runtime.mjs --runtime-root .cache/cocode/release-runtime",
		"verify:linux-appimage": "node scripts/release/verify-linux-appimage.mjs",
		"verify:mac-pkg": "node scripts/release/verify-mac-pkg.mjs",
		"uninstall:mac-cli": "node scripts/release/uninstall-mac-cli.mjs",
		"check:release-env": "node scripts/check-release-env.mjs",
		"prepare:release-assets": "node scripts/harden-electron-default-app.mjs && corepack pnpm@10.34.5 run generate:mac-icons && corepack pnpm@10.34.5 run build:runtime -- --clean && corepack pnpm@10.34.5 run build:tui",
		"prepackage": "corepack pnpm@10.34.5 run prepare:release-assets",
		"package": "electron-vite build && electron-builder --dir --publish never --config electron-builder.config.ts",
		"premake": "corepack pnpm@10.34.5 run prepare:release-assets",
		"make": "electron-vite build && electron-builder --publish never --config electron-builder.config.ts",
		"release:mac:x64": "tsx scripts/release/build-release.ts --platform darwin --arch x64",
		"release:mac:arm64": "tsx scripts/release/build-release.ts --platform darwin --arch arm64",
		"release:win:x64": "tsx scripts/release/build-release.ts --platform win32 --arch x64",
		"release:win:arm64": "tsx scripts/release/build-release.ts --platform win32 --arch arm64",
		"release:linux:x64": "tsx scripts/release/build-release.ts --platform linux --arch x64",
		"release:linux:arm64": "tsx scripts/release/build-release.ts --platform linux --arch arm64",
		"publish": "corepack pnpm@10.34.5 run prepare:release-assets && electron-vite build && electron-builder --config electron-builder.config.ts --publish always",
		"test": "tsx --test \"tests/**/*.test.ts\"",
		"lint": "oxlint --deny-warnings src scripts tests",
		"lint:fix": "oxlint --fix src scripts tests",
		"lint:ci": "node scripts/check-changed-files.mjs lint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"format:ci": "node scripts/check-changed-files.mjs format",
		"commitlint": "commitlint",
		"prepare": "husky",
		"check:env": "node scripts/check-env.mjs",
		"windows-sign:configure": "node scripts/release/windows-sign-credentials.cjs configure",
		"windows-sign:clear": "node scripts/release/windows-sign-credentials.cjs clear",
		"windows-sign:status": "node scripts/release/windows-sign-credentials.cjs status",
		"reconcile:processes": "node scripts/reconcile-owned-processes.mjs",
		"typecheck": "tsc --noEmit",
		"typecheck:ci": "tsc --noEmit --project tsconfig.ci.json"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@commitlint/cli": "19.8.1",
		"@dtyq/eslint-config": "0.0.11",
		"@electron/asar": "3.4.1",
		"@electron/fuses": "^1.8.0",
		"@electron/notarize": "2.5.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"autoprefixer": "^10.5.4",
		"chokidar": "3.6.0",
		"electron": "43.4.0",
		"electron-builder": "26.15.3",
		"electron-vite": "5.0.0",
		"form-data": "4.0.6",
		"husky": "9.1.7",
		"keytar": "7.9.0",
		"lightningcss": "1.32.0",
		"lint-staged": "15.5.2",
		"node-fetch": "2.7.0",
		"oxlint": "1.76.0",
		"pathe": "^2.0.3",
		"postcss": "^8.5.26",
		"prettier": "2.8.8",
		"tailwindcss": "^3.4.19",
		"tsdown": "0.21.10",
		"tsx": "^4.23.12",
		"typescript": "~5.1.6",
		"vite": "^5.4.21"
	},
	"dependencies": {
		"@cocode-agency/host-supervisor": "link:../cocode-host-supervisor",
		"@hookform/resolvers": "^5.7.1",
		"@radix-ui/react-accordion": "^1.2.20",
		"@radix-ui/react-alert-dialog": "^1.1.23",
		"@radix-ui/react-aspect-ratio": "^1.1.15",
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-checkbox": "^1.3.11",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-context-menu": "^2.3.7",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-hover-card": "^1.1.23",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-menubar": "^1.1.24",
		"@radix-ui/react-navigation-menu": "^1.2.22",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-progress": "^1.1.16",
		"@radix-ui/react-radio-group": "^1.4.7",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slider": "^1.4.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-switch": "^1.3.7",
		"@radix-ui/react-tabs": "^1.1.21",
		"@radix-ui/react-toast": "^1.2.23",
		"@radix-ui/react-toggle": "^1.1.18",
		"@radix-ui/react-toggle-group": "^1.1.19",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@shikijs/langs": "4.3.1",
		"anser": "2.3.5",
		"better-sqlite3": "^13.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"electron-updater": "6.8.9",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"katex": "0.16.47",
		"lucide-react": "^1.31.0",
		"mdast-util-from-markdown": "2.0.3",
		"mdast-util-gfm": "3.1.0",
		"mdast-util-math": "3.0.0",
		"micromark-extension-gfm": "3.0.0",
		"micromark-extension-math": "3.1.0",
		"next-themes": "^0.4.6",
		"pino": "^10.3.1",
		"react": "^18.3.1",
		"react-day-picker": "^10.0.1",
		"react-dom": "^18.3.1",
		"react-hook-form": "^7.85.0",
		"react-resizable-panels": "^4.12.2",
		"shiki": "4.3.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tar": "^7.5.22",
		"vaul": "^1.1.2",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	}
}
